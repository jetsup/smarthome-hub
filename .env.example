# ── Server ──────────────────────────────────────────
SERVER_PORT=9000
TCP_PORT=9010

# ── MariaDB ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smarthome
DB_PASS=smarthome
DB_NAME=smarthome

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret

# ── Node Offline Timeout (seconds) ──────────────────
# How long without a ping/telemetry before a node is considered offline.
# Default: 300 (5 minutes)
# NODE_OFFLINE_TIMEOUT=300
