# ── Server ──────────────────────────────────────────
SERVER_PORT=9000
TCP_PORT=9010

# ── MariaDB ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smarthome
DB_PASS=smarthome
DB_NAME=smarthome

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret

# ── Node Offline Timeout (seconds) ──────────────────
# How long without a ping/telemetry before a node is considered offline.
# Default: 300 (5 minutes)
# NODE_OFFLINE_TIMEOUT=300

# ── Static UI / CORS ────────────────────────────────
# Directory containing the built Vue SPA (index.html). Auto-detected if unset
# (../smarthome-ui/dist, ./ui/dist, ./dist, next to the binary).
# UI_DIR=../smarthome-ui/dist
# Comma-separated browser origins allowed for cross-origin API calls.
# Default: Vite dev server only (the bundled SPA is same-origin and needs none).
# CORS_ORIGINS=http://localhost:5173

# ── Two-step verification & email ───────────────────────
# Users can turn on: approve-in-the-app, an authenticator app (Google Authenticator,
# Authy, ...), and/or codes sent by email.

# How long an emailed code stays valid, in minutes (1-60). Default: 10
# MFA_EMAIL_CODE_TTL_MINUTES=10

# Outgoing mail (needed only for email codes). Without SMTP_HOST the email option is
# hidden from sign-in and cannot be turned on.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=app-password
# starttls (default, port 587) | tls (implicit TLS, port 465) | none (trusted local relay only)
# SMTP_SECURITY=starttls
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=SmartHome
# Where the web UI lives; adds an "Open SmartHome" button to emails.
# PUBLIC_URL=https://smarthome.example.com
